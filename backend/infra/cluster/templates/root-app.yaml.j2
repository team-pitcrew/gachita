# 뿌리 앱. 클러스터에 직접 넣는 Argo CD 앱은 이것 하나다. 나머지는 이 앱이 읽는 폴더에서 물결 순서로 온다.
# 지우면 자식 앱이 남는다(지운 것이 모든 것을 지우지 않게 일부러 finalizer를 두지 않음).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: default
  source:
    repoURL: {{ gitops_repo }}
    targetRevision: {{ gitops_revision }}
    path: backend/infra/gitops/bootstrap
    kustomize:
      patches:
        # 이 저장소를 읽는 자식 앱도 뿌리 앱과 같은 저장소·판을 따라간다(Terraform 변수 gitops_repo, gitops_revision).
        # 병합 전 브랜치나 다른 주소(미러)로 실제 계정에 펴 볼 수 있다. 차트를 읽는 앱은 건드리지 않는다.
        - target:
            kind: Application
            name: "(cluster-base|secret-stores|pod-identity-webhook|db|api|edge)"
          patch: |-
            - { op: replace, path: /spec/source/repoURL, value: "{{ gitops_repo }}" }
            - { op: replace, path: /spec/source/targetRevision, value: "{{ gitops_revision }}" }
{% if db_bootstrap == 'recover' %}
        # 데이터 버킷에 Postgres 전체 백업이 있어 복구로 편다(T52, 구축 6단계가 정함)
        - target: { kind: Application, name: db }
          patch: |-
            - { op: replace, path: /spec/source/path, value: backend/infra/gitops/apps/db/recover }
{% endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    retry:
      limit: 5
      backoff: { duration: 10s, factor: 2, maxDuration: 3m }
