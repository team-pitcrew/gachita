<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
 <uses-permission android:name="android.permission.INTERNET" />
 <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
 <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
 <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" /> <!-- 경로 요청·경유지 추가(requestRoute, addWaypoint)에 필요. 없으면 SecurityException(T9 에뮬레이터) -->
 <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
 <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <!-- 평문 http는 에뮬레이터에서 본 개발 서버(10.0.2.2)와 기기 자신에만 허용한다(res/xml/network_security_config.xml). 나머지는 https만.
      minSdk 29: 마이크 유형 포그라운드 서비스와 녹음 막힘 확인(AudioRecordingConfiguration)이 API 29부터. Pleos Connect는 API 34.
      주행 중 쓰는 화면으로 선언(distractionOptimized)해 기어 D에서도 앞에 남는다. 막을 것은 앱이 주행 제한 값을 보고 가린다(T11). -->
 <application android:label="가치타" android:icon="@drawable/ic_launcher" android:theme="@android:style/Theme.Material.Light.NoActionBar"
  android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config">
  <uses-library android:name="ai.pleos.playground.car" android:required="true" />
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:resizeableActivity="true"
   android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|density">
   <!-- 낮·밤 전환이나 창 크기 변화로 화면이 다시 만들어지면 내비 답을 기다리던 경유지 추가와 수음이 끊긴다. Compose가 바뀐 설정으로 다시 그린다 -->
   <meta-data android:name="distractionOptimized" android:value="true" />
   <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
   <!-- Gleo 함수(assets/schema.json, T40). Gleo는 함수 이름이나 '<패키지>.<함수 이름>'을 action으로 보낸다 -->
   <intent-filter><action android:name="GACHITA_ARRIVAL_TASKS" /><action android:name="io.github.teampitcrew.gachita.GACHITA_ARRIVAL_TASKS" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
  </activity>
  <service android:name=".CaptureService" android:exported="false" android:foregroundServiceType="microphone" />
 </application>
</manifest>
