#!/bin/sh
# 커밋 전에: 장기 브랜치 직접 커밋 금지, 브랜치 이름, 비밀 값 검사.
set -eu
root=$(git rev-parse --show-toplevel)
branch=$(git symbolic-ref --quiet --short HEAD || echo "")

if [ -n "$branch" ]; then
  "$root/.github/scripts/policy.sh" branch "$branch"
  # main과 develop에는 PR로만 넣는다. 병합 중인 커밋은 예외다.
  if { [ "$branch" = main ] || [ "$branch" = develop ]; } && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    echo "$branch 에는 직접 커밋하지 않습니다. feature/T번호-설명 브랜치에서 PR로 올립니다." >&2
    exit 1
  fi
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner --redact --config "$root/.gitleaks.toml" "$root"
else
  echo "gitleaks가 없어 비밀 값 검사를 건너뜁니다(CI에서는 검사합니다). 설치: brew install gitleaks" >&2
fi
